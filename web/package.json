{
  "name": "barge-monitor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../contracts/openapi.json -o src/generated/api.d.ts",
    "pyodide": "node scripts/fetch-pyodide.mjs",
    "pack-python": "python3 ../scripts/pack_python.py public/py/barge.zip",
    "prebuild": "npm run gen && npm run pack-python",
    "build": "tsc --noEmit && vite build",
    "site": "node scripts/assemble-site.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uplot": "1.6.31"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
