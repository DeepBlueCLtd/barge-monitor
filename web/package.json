{
  "name": "barge-monitor-web",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../contracts/openapi.json -o src/generated/api.d.ts && node scripts/gen-schema-types.mjs",
    "pyodide": "node scripts/fetch-pyodide.mjs",
    "pack-python": "python3 ../scripts/pack_python.py public/py/barge.zip",
    "prebuild": "npm run gen && npm run pack-python",
    "build": "tsc --noEmit && vite build",
    "site": "node scripts/assemble-site.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test --trace off",
    "e2e:python": "E2E_BACKEND=python playwright test --trace off"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/patrick-hand-sc": "5.3.0",
    "@xyflow/react": "12.12.1",
    "codemirror": "6.0.1",
    "echarts": "5.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "2.3.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
