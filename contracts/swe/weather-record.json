{
 "type": "DataRecord",
 "name": "record",
 "label": "Weather record",
 "description": "weather__{dataset}: a sensor's seven quantities, each with its QARTOD flag (interfaces §6). A dataset whose file lacks a column has the record without that quantity and its flag (FR-21).",
 "fields": [
  {
   "type": "Time",
   "name": "time",
   "label": "Sampling time",
   "definition": "http://www.opengis.net/def/property/OGC/0/SamplingTime",
   "referenceFrame": "http://www.opengis.net/def/trs/BIPM/0/UTC",
   "uom": {
    "href": "http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"
   }
  },
  {
   "type": "Quantity",
   "name": "air_temperature",
   "label": "Air temperature",
   "definition": "https://deepbluecltd.github.io/barge-monitor/def/air_temperature",
   "uom": {
    "code": "Cel"
   },
   "quality": [
    {
     "href": "#air_temperature_qc"
    }
   ]
  },
  {
   "type": "Category",
   "name": "air_temperature_qc",
   "id": "air_temperature_qc",
   "label": "QC flag: Air temperature",
   "definition": "https://ioos.github.io/qartod/flag",
   "codeSpace": "https://ioos.github.io/qartod/",
   "constraint": {
    "type": "AllowedTokens",
    "values": [
     "1",
     "2",
     "3",
     "4",
     "9"
    ]
   },
   "description": "QARTOD: 1 pass, 2 not evaluated, 3 suspect, 4 fail, 9 missing"
  },
  {
   "type": "Quantity",
   "name": "apparent_wind_speed",
   "label": "Wind speed",
   "definition": "https://deepbluecltd.github.io/barge-monitor/def/apparent_wind_speed",
   "description": "Apparent wind speed, as felt aboard.",
   "uom": {
    "code": "m/s"
   },
   "quality": [
    {
     "href": "#apparent_wind_speed_qc"
    }
   ]
  },
