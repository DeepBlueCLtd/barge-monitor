{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepbluecltd.github.io/barge-monitor/contracts/schemas/data-of-interest.json",
  "title": "Data of interest (SRD FR-94)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "label",
    "dataset",
    "start",
    "end",
    "resolution",
    "aggregation",
    "sources",
    "created"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "size",
        "modified",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "resolution": {
      "type": "string",
      "description": "ISO 8601 duration. For now only PT1S, PT1M and PT1H exist as datastreams (FR-94a).",
      "pattern": "^P(T(\\d+H)?(\\d+M)?(\\d+S)?)$"
    },
    "aggregation": {
      "enum": [
        "as-stored",
        "mean",
        "min",
        "max"
      ],
      "description": "Only as-stored is offered for now; the others are reserved."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "output",
          "fields"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "output": {
            "type": "string",
            "description": "Output name without '__<dataset id>'"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "run": {
      "type": "string"
    },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "by"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "by": {
          "type": "string"
        }
      }
    }
  }
}
