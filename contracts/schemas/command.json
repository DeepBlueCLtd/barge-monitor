{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://deepbluecltd.github.io/barge-monitor/contracts/schemas/command.json",
 "title": "Command",
 "type": "object",
 "required": [
  "id",
  "controlstream@id",
  "issueTime",
  "parameters",
  "currentStatus"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "controlstream@id": {
   "type": "string"
  },
  "issueTime": {
   "type": "string"
  },
  "parameters": {
   "type": "object"
  },
  "sender": {
   "type": "string",
   "description": "the sending user id, as OpenSensorHub puts it on a command (D-152)"
  },
  "currentStatus": {
   "enum": [
    "PENDING",
    "ACCEPTED",
    "REJECTED",
    "SCHEDULED",
    "UPDATED",
    "CANCELED",
    "EXECUTING",
    "FAILED",
    "COMPLETED"
   ]
  },
  "links": {
   "type": "array",
   "items": {
    "$ref": "link.json"
   }
  }
 }
}
